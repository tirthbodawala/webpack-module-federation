{
  "extends": "@crisil/ts-config/react.json",
  "compilerOptions": {
    "noPropertyAccessFromIndexSignature": false,
    "plugins": [
      {
        "name": "typescript-plugin-css-modules",
        "options": {
          "classnameTransform": "asIs"
        }
      }
    ]
  },
  "include": [
    "./src/**/*",
    "./src/@types/declarations.d.ts"
  ],
  "exclude": ["node_modules"]
}
