{
  "name": "webpack-react-config",
  "version": "1.0.0",
  "description": "Reusable webpack configuration for React applications with TypeScript support",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run build:clean && npm run build:esm",
    "build:clean": "rimraf dist",
    "build:esm": "tsc -p tsconfig.build.json",
    "build:watch": "npm run build && chokidar \"src/**/*\" -c \"npm run build\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "validate": "npm run type-check && npm run lint && npm run format:check && npm run test",
    "check-updates": "npm outdated",
    "audit": "npm audit",
    "audit:fix": "npm audit fix",
    "deps:check": "npm run check-updates && npm run audit",
    "deps:update": "npm run test && npm run build",
    "posttest": "npm run deps:check --silent || true",
    "prepublishOnly": "npm run build && npm run test"
  },
  "keywords": [
    "webpack",
    "react",
    "typescript",
    "babel",
    "configuration"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "typescript": ">=4.0.0",
    "webpack": ">=5.0.0",
    "webpack-cli": ">=5.0.0"
  },
  "dependencies": {
    "@babel/core": "^7.28.4",
    "@babel/plugin-syntax-top-level-await": "^7.14.5",
    "@babel/plugin-transform-class-properties": "^7.27.1",
    "@babel/plugin-transform-private-methods": "^7.27.1",
    "@babel/plugin-transform-private-property-in-object": "^7.27.1",
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@module-federation/enhanced": "^0.19.1",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.6.1",
    "@svgr/webpack": "^8.1.0",
    "babel-loader": "^10.0.0",
    "babel-plugin-transform-react-remove-prop-types": "^0.4.24",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "babel-plugin-transform-remove-undefined": "^0.5.0",
    "copy-webpack-plugin": "^13.0.1",
    "css-loader": "^7.1.2",
    "css-minimizer-webpack-plugin": "^7.0.2",
    "cssnano": "^7.1.1",
    "dotenv": "^17.2.3",
    "external-remotes-plugin": "^1.0.0",
    "html-webpack-plugin": "^5.6.4",
    "mini-css-extract-plugin": "^2.9.4",
    "postcss-loader": "^8.2.0",
    "postcss-preset-env": "^10.4.0",
    "react-refresh": "^0.18.0",
    "sass": "^1.93.2",
    "sass-loader": "^16.0.5",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.3.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@jest/globals": "^30.2.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.6.2",
    "@types/webpack": "^5.28.5",
    "@types/webpack-bundle-analyzer": "^4.7.0",
    "chokidar-cli": "^3.0.0",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^30.2.0",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.4.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.45.0",
    "webpack-dev-server": "^5.2.2"
  },
  "optionalDependencies": {
    "webpack-bundle-analyzer": "^4.10.2"
  }
}
