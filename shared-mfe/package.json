{
  "name": "@crisil/shared",
  "version": "1.0.0",
  "description": "Shared application for Module Federation",
  "author": "",
  "type": "module",
  "scripts": {
    "dev": "webpack serve",
    "build": "cross-env NODE_ENV=production webpack",
    "test": "echo \"Error: no test specified\" && exit 1",
    "type-check": "tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,scss}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,scss}\"",
    "style-lint": "stylelint \"src/**/*.{css,scss}\"",
    "style-lint:fix": "stylelint \"src/**/*.{css,scss}\" --fix"
  },
  "devDependencies": {
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "cross-env": "^10.0.0",
    "eslint": "^9.36.0",
    "mfe-build-tools": "file:../mfe-build-tools",
    "prettier": "^3.6.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "stylelint": "^16.25.0",
    "typescript": "^5.9.2",
    "webpack": "^5.101.3",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2"
  }
}
